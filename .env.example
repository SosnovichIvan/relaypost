# Copy to .env; load with: set -a; source .env; set +a
TELEGRAM_BOT_TOKEN=
# .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
RELAYPOST_ENCRYPTION_KEY=
RELAYPOST_DATABASE=relaypost.db
# Optional allowlist: comma-separated Telegram user IDs. Empty = public access.
RELAYPOST_ALLOWED_USERS=
# Private Telegram user ID receiving /support; 0 disables intake.
SUPPORT_CHAT_ID=0

# Local optional tunnel endpoint; production always uses its private Compose service.
TELEGRAM_PROXY_URL=
